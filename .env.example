# Chaves de API para execução dos Agentes com LLMs reais (Opcional - o sistema possui modo demonstração embutido)
# Para usar com Google Gemini (Recomendado):
GEMINI_API_KEY=sua_chave_gemini_aqui

# Para usar com OpenAI:
# OPENAI_API_KEY=sua_chave_openai_aqui

# Configurações do Sistema
LLM_MODEL=gemini-1.5-pro
MAX_AUDIT_ITERATIONS=3
MIN_PASSING_SCORE=8.5
